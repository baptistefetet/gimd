# Port the Node server listens on (reverse-proxied by Apache).
PORT=3004

# GitHub OAuth App credentials.
# Create one at: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   Homepage URL:               https://gimd.pbat.ovh
#   Authorization callback URL: https://gimd.pbat.ovh/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must exactly match the "Authorization callback URL" of the OAuth App above.
OAUTH_CALLBACK_URL=https://gimd.pbat.ovh/auth/callback

# Secret used to encrypt the session cookie (AES-256-GCM).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Only this GitHub login is allowed to sign in (single-user instance).
ALLOWED_GITHUB_LOGIN=

# Name of the private repository that stores the notes (auto-created if missing).
NOTES_REPO=gimd-notes

# production | development
NODE_ENV=production
